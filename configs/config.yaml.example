# Agent configuration — copy to config.yaml and edit.
postgres:
  host: "localhost"
  port: 5432
  database: "postgres"
  user: "yama"
  # password: ""        # or set PG_PASSWORD in the environment
  sslmode: "prefer"
  # max_db_connections: 1   # max concurrent connections to PostgreSQL (default 1, minimum 1)

collector:
  interval: 10s         # global collection interval (per-metric override in metrics.yaml)
  query_timeout: 3s     # global query timeout (per-metric override in metrics.yaml; must not exceed effective interval)

storage:
  data_dir: "./data"

api:
  listen: ":8080"
